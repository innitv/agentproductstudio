    "preview": "node node_modules/vite/bin/vite.js preview --config apps/frontend/vite.config.ts --host 127.0.0.1",
    "storybook": "storybook dev -p 6006 -c apps/frontend/.storybook",
    "build-storybook": "storybook build -c apps/frontend/.storybook -o dist/storybook",
    "test-storybook": "vitest run --project=storybook",
    "qa:studio": "yarn build:studio && node tooling/scripts/run-and-log.mjs playwright-studio \"node tooling/scripts/run-playwright-with-preview.mjs --app=frontend tests/playwright/studio.spec.ts\"",
    "qa:playwright": "yarn qa:studio && yarn qa:firecrawl",
    "qa:mobile": "node tests/mobile-acceptance.check.mjs",
    "qa:firecrawl": "yarn build:studio && node tooling/scripts/run-and-log.mjs playwright-firecrawl \"node tooling/scripts/run-playwright-with-preview.mjs --app=frontend tests/playwright/firecrawl.spec.ts\"",
    "qa:playwright:install": "yarn playwright install chromium",
    "vr:test": "node tooling/scripts/run-visual-regression.mjs",
    "vr:update": "node tooling/scripts/run-visual-regression.mjs --update",
    "docs:audit": "node tooling/scripts/run-and-log.mjs docs-audit \"node tooling/scripts/audit-docs.mjs\"",
    "qa:quick": "yarn typecheck && yarn validate:config && yarn docs:audit",
    "qa:all": "yarn qa:quick && yarn qa:playwright",
