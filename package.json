    "workflow:test-context-truncator": "tsx runtime/typescript/test-context-truncator.ts",
    "workflow:test-intent-parser": "tsx runtime/typescript/test-intent-parser.ts",
    "workflow:test-visual-reference-review": "tsx runtime/typescript/test-visual-reference-review.ts",
    "workflow:test-agent-metadata": "tsx runtime/typescript/test-agent-metadata.ts",
    "workflow:test-agent-capabilities": "yarn tsx runtime/typescript/test-agent-capability-registry.ts",
    "workflow:test-agent-output-skeletons": "yarn tsx runtime/typescript/test-agent-output-skeletons.ts",
    "workflow:test-agent-output-critic": "tsx runtime/typescript/test-agent-output-critic.ts",
    "workflow:test-skill-metadata": "tsx runtime/typescript/test-skill-metadata.ts",
    "workflow:test-skill-usage": "tsx runtime/typescript/test-skill-usage.ts",
    "workflow:test-figma-layout-contract": "yarn tsx runtime/typescript/test-figma-layout-contract.ts",
    "workflow:test-figma-layout-verifier": "yarn tsx runtime/typescript/test-figma-layout-verifier.ts",
    "workflow:test-output-metadata": "tsx runtime/typescript/test-output-metadata.ts",
    "workflow:test-output-lifecycle": "tsx runtime/typescript/test-output-lifecycle.ts",
    "workflow:test-outputs-registry": "tsx runtime/typescript/test-outputs-registry.ts",
    "workflow:test-research-registry": "tsx runtime/typescript/test-research-registry.ts",
    "workflow:test-run-retro": "tsx runtime/typescript/test-run-retro.ts",
    "workflow:test-guard-bash-hook": "tsx runtime/typescript/test-guard-bash-hook.ts",
    "workflow:test-multi-source-research": "tsx runtime/typescript/test-multi-source-research.ts",
    "workflow:test-agentic-rollout": "tsx runtime/typescript/test-agentic-rollout.ts",
    "workflow:test-approval-gate": "tsx runtime/typescript/test-approval-gate.ts",
    "workflow:test-agentic-executor": "tsx runtime/typescript/test-agentic-executor.ts",
