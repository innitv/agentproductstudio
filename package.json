{
  "name": "agent-product-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "description": "Artifact-driven product workflow studio for Claude Code.",
  "scripts": {
    "agent:verify-output": "tsx runtime/typescript/agent-output-critic.ts",
