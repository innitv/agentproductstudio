{
  "button": {
    "radius": {
      "$type": "dimension",
      "$value": "{border-radius.buttons}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.2x}"
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.mont}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "xl": {
      "height": {
        "$type": "dimension",
        "$value": "{size.xl}"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.4x}"
      },
      "icon-size": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.body-s.size}"
      },
      "line-height": {
        "$type": "dimension",
        "$value": "{font.body-s.line}"
      }
    },
