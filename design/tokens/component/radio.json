{
  "radio": {
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.1-5x}"
    },
    "size": {
      "s": {
        "circle": {
          "$type": "dimension",
          "$value": {
            "value": 22,
            "unit": "px"
          }
        },
        "control": {
          "$type": "dimension",
          "$value": {
            "value": 22,
            "unit": "px"
          }
        },
        "height": {
          "$type": "dimension",
          "$value": "{size.s}"
        },
        "dot": {
          "$type": "dimension",
          "$value": {
            "value": 8,
            "unit": "px"
          }
        }
      },
      "xs": {
        "circle": {
          "$type": "dimension",
          "$value": {
            "value": 20,
            "unit": "px"
          }
        },
        "control": {
          "$type": "dimension",
          "$value": {
            "value": 20,
            "unit": "px"
          }
        },
        "height": {
          "$type": "dimension",
          "$value": "{size.xs}"
        },
        "dot": {
          "$type": "dimension",
          "$value": {
            "value": 7,
            "unit": "px"
          }
        }
      }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        }
      },
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.48627450980392156,
            0.5411764705882353,
            0.6196078431372549
          ],
          "alpha": 0.25,
          "hex": "#7c8a9e"
        }
      },
      "hover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.48627450980392156,
            0.5411764705882353,
            0.6196078431372549
          ],
          "alpha": 0.5,
          "hex": "#7c8a9e"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{border-radius.full}"
    },
    "fill": {
      "checked": {
        "$type": "color",
        "$value": "{base.accent}"
      },
      "checked-hover": {
        "$type": "color",
        "$value": "{accent.600}"
      },
      "disabled": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.48627450980392156,
            0.5411764705882353,
            0.6196078431372549
          ],
          "alpha": 0.15,
          "hex": "#7c8a9e"
        }
      }
    },
    "dot": {
      "default": {
        "$type": "color",
        "$value": "{neutral.0}"
      },
      "disabled": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.48627450980392156,
            0.5411764705882353,
            0.6196078431372549
          ],
          "alpha": 0.8,
          "hex": "#7c8a9e"
        }
      }
    },
    "label": {
      "default": {
        "$type": "color",
        "$value": "{neutral.1000}"
      },
      "disabled": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.48627450980392156,
            0.5411764705882353,
            0.6196078431372549
          ],
          "alpha": 0.8,
          "hex": "#7c8a9e"
        }
