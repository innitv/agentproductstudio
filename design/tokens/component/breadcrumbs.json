{
  "breadcrumbs": {
    "height": {
      "$type": "dimension",
      "$value": "{size.s}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.3x}"
    },
    "text": {
      "$type": "color",
      "$value": "{neutral.1000}"
    },
    "text-hover": {
      "$type": "color",
      "$value": "{neutral.600}"
    },
    "current": {
      "$type": "color",
      "$value": "{neutral.300}"
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.mont}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{font.description-s.size}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "line-height": {
      "$type": "dimension",
      "$value": "{font.description-s.line}"
    },
    "separator-size": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "more": {
      "size": {
        "$type": "dimension",
        "$value": "{size.s}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{border-radius.l}"
      },
      "bg": {
        "hover": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.48627450980392156,
              0.5411764705882353,
              0.6196078431372549
            ],
            "alpha": 0.1,
            "hex": "#7c8a9e"
          }
        },
        "active": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.48627450980392156,
              0.5411764705882353,
              0.6196078431372549
            ],
            "alpha": 0.2,
            "hex": "#7c8a9e"
          }
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{neutral.1000}"
      },
      "fg-hover": {
        "$type": "color",
        "$value": "{neutral.600}"
      },
      "fg-active": {
        "$type": "color",
        "$value": "{neutral.700}"
      }
    },
    "dropdown-width": {
      "$type": "dimension",
      "$value": {
        "value": 120,
        "unit": "px"
      }
    }
  }
}
