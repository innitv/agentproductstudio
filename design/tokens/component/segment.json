      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.48627450980392156,
          0.5411764705882353,
          0.6196078431372549
        ],
        "alpha": 0.1,
        "hex": "#7c8a9e"
      }
    },
    "bg-selected": {
      "$type": "color",
      "$value": "{base.accent}"
    },
    "bg-disabled-selected": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.48627450980392156,
          0.5411764705882353,
          0.6196078431372549
        ],
        "alpha": 0.15,
        "hex": "#7c8a9e"
      }
    },
    "fg": {
