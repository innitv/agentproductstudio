          "$value": "{spacing.4x}"
        }
      },
      "icon-size": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.body-s.size}"
      },
      "line-height": {
        "$type": "dimension",
        "$value": "{font.body-s.line}"
