        }
      },
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.3x}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.description-l.size}"
      },
      "line-height": {
        "$type": "dimension",
        "$value": "{font.description-l.line}"
      },
      "label": {
        "size": {
          "$type": "dimension",
          "$value": "{font.description-s.size}"
        },
        "line": {
          "$type": "dimension",
          "$value": "{font.description-s.line}"
