        "$value": "{input.border.hover}"
      },
      "focus": {
        "$type": "color",
        "$value": "{input.border.focus}"
      },
      "error": {
        "$type": "color",
        "$value": "{input.border.error}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{input.border.disabled}"
      }
    },
    "bg": {
      "$type": "color",
      "$value": "{input.bg}"
    },
    "bg-error": {
      "$type": "color",
      "$value": "{input.bg-error}"
    },
    "bg-disabled": {
      "$type": "color",
      "$value": "{input.bg-disabled}"
