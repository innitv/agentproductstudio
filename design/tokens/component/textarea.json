        "$type": "dimension",
        "$value": {
          "value": 56,
          "unit": "px"
        }
      },
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.2x}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.description-s.size}"
      },
      "line-height": {
        "$type": "dimension",
        "$value": "{font.description-s.line}"
      },
      "label": {
        "size": {
          "$type": "dimension",
          "$value": "{font.description-s.size}"
        },
        "line": {
          "$type": "dimension",
          "$value": "{font.description-s.line}"
