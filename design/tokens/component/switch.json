{
  "switch": {
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.1-5x}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{border-radius.full}"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.48627450980392156,
            0.5411764705882353,
            0.6196078431372549
          ],
          "alpha": 0.25,
          "hex": "#7c8a9e"
        }
      },
      "off-hover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.48627450980392156,
            0.5411764705882353,
            0.6196078431372549
          ],
          "alpha": 0.5,
          "hex": "#7c8a9e"
        }
      },
      "on": {
        "$type": "color",
        "$value": "{base.accent}"
      },
      "on-hover": {
        "$type": "color",
        "$value": "{accent.600}"
      }
    },
    "knob": {
      "bg": {
        "$type": "color",
        "$value": "{neutral.0}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.bottom.controls}"
      }
    },
    "label": {
      "default": {
        "$type": "color",
        "$value": "{neutral.1000}"
      },
      "disabled": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.48627450980392156,
            0.5411764705882353,
            0.6196078431372549
          ],
          "alpha": 0.8,
          "hex": "#7c8a9e"
        }
      }
    },
    "size": {
      "s": {
        "track": {
          "width": {
            "$type": "dimension",
            "$value": {
              "value": 44,
              "unit": "px"
            }
          },
          "height": {
            "$type": "dimension",
            "$value": {
              "value": 24,
              "unit": "px"
            }
          }
        },
        "knob": {
          "$type": "dimension",
          "$value": {
            "value": 20,
            "unit": "px"
          }
        },
        "knob-offset": {
          "$type": "dimension",
          "$value": {
            "value": 2,
            "unit": "px"
          }
        },
        "label": {
          "size": {
            "$type": "dimension",
            "$value": "{font.body-s.size}"
          },
          "line": {
            "$type": "dimension",
            "$value": "{font.body-s.line}"
          }
        }
      },
      "xs": {
        "track": {
          "width": {
            "$type": "dimension",
            "$value": {
              "value": 32,
              "unit": "px"
            }
          },
          "height": {
            "$type": "dimension",
            "$value": {
              "value": 18,
              "unit": "px"
            }
          }
        },
        "control-height": {
          "$type": "dimension",
          "$value": "{size.xs}"
        },
        "knob": {
          "$type": "dimension",
          "$value": {
            "value": 14,
            "unit": "px"
          }
        },
        "knob-offset": {
          "$type": "dimension",
          "$value": {
            "value": 2,
            "unit": "px"
          }
        },
        "label": {
          "size": {
            "$type": "dimension",
            "$value": "{font.description-l.size}"
          },
          "line": {
            "$type": "dimension",
            "$value": "{font.description-l.line}"
          }
        }
      }
    }
  }
}
